# W162 sim — hub compose defaults. Copy to .env to override.
# No real hosts, no key material, no tokens in committed files (law).

# Hub ports (host loopback; spoke owns 4000/4100/4101/7794/7799/890x)
SIM_BUCKLE_PORT=17001
SIM_BOARD_PORT=17002
SIM_STORE_PORT=17003
SIM_BELT_PORT=17004

# Repo bind-mount sources (compose resolves relative to sim/; defaults fine
# when the klh trio sits side by side). Override if your checkout differs.
# SIM_BUCKLE_REPO=../../buckle
# SIM_SUSPENDERS_REPO=..
# SIM_BELT_REPO=../../belt

# buckle auth mode for the sim hub. "on" = W141 gate enforced; with no root
# key provisioned the admin/proxy surfaces honestly 401 (the smoke checks
# that 401s carry WWW-Authenticate). Leave "on".
SIM_BUCKLE_AUTH=on
