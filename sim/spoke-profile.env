# sim/spoke-profile.env — W162 SIM spoke profile: points the spoke's
# policy-pull / JWKS / CR-check at the hub containers. NOT wired into the
# live ~/.claude wiring — activation is an explicit, opt-in step (the sim
# profile is a pointing document, not a live config).
#
# Production shape for reference (never point the real spoke at a sim):
#   SIM_HUB_BUCKLE_URL=https://hub.buckle.internal
#   SIM_HUB_STORE_URL=https://hub.suspenders.internal
# Sim defaults = host loopback (hub and spoke share this machine).

SIM_HUB_BUCKLE_URL=http://127.0.0.1:17001
SIM_HUB_STORE_URL=http://127.0.0.1:17003
SIM_HUB_BOARD_URL=http://127.0.0.1:17002
SIM_HUB_BELT_URL=http://127.0.0.1:17004
