<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.suspenders.llm-keepwarm</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BUN__</string>
		<string>__PREFIX__/bin/llm-keepwarm.ts</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>240</integer>
	<key>StandardOutPath</key>
	<string>/tmp/llm-keepwarm.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/llm-keepwarm.err</string>
	<key>Nice</key>
	<integer>10</integer>
</dict>
</plist>
