<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.knowledge-api</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__PREFIX__/bin/knowledge-api.ts</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/suspenders-knowledge-api.log</string>
  <key>StandardErrorPath</key><string>/tmp/suspenders-knowledge-api.log</string>
</dict></plist>
