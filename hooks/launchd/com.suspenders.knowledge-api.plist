<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.knowledge-api</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__PREFIX__/bin/knowledge-api.ts</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <!-- W103: resolution root for source_ref hashing (trust markers on
       /search hits) + the default repo for POST /curate -->
  <key>EnvironmentVariables</key><dict>
    <key>KNOWLEDGE_REPO_ROOT</key><string>__REPO__</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/.claude-insights/logs/suspenders-knowledge-api.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude-insights/logs/suspenders-knowledge-api.log</string>
</dict></plist>
