<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.knowledge-worker</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__PREFIX__/bin/knowledge-worker.ts</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <!-- W96 distill target: belt decides, local-first — the worker's
       BeltDistillClient sends hint 'prefer local distill reasoning' and belt
       picks the local model again (the :8903 INGEST_LLM_URL pin is retired).
       Enterprise override stays available: INGEST_LLM_URL env still wins in
       makeDistillClient(). -->
  <key>StandardOutPath</key><string>/tmp/suspenders-knowledge-worker.log</string>
  <key>StandardErrorPath</key><string>/tmp/suspenders-knowledge-worker.log</string>
</dict></plist>
