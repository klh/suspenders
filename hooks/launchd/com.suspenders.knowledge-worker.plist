<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.knowledge-worker</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__PREFIX__/bin/knowledge-worker.ts</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <!-- distill target: local large model by default (owner 2026-09-30 —
       knowledge ingest is a slow-queue chore, keep it off the paid cloud;
       unset/override via env to route through belt instead) -->
  <key>EnvironmentVariables</key><dict>
    <key>INGEST_LLM_URL</key><string>http://127.0.0.1:8903</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/suspenders-knowledge-worker.log</string>
  <key>StandardErrorPath</key><string>/tmp/suspenders-knowledge-worker.log</string>
</dict></plist>
