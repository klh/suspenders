<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.store-server</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__PREFIX__/bin/store-server.ts</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <!-- W92 control-plane store port: loopback-only governor.db API on :7794.
       DELIVERED, NOT INSTALLED — activation is a coordinator/owner step:
       launchctl bootstrap gui/$UID <plist>, then write the resolved
       http://127.0.0.1:7794 one-liner to ~/.cache/claude-governor/store.url
       (or export GOVERNOR_STORE_URL per machine). Remote machines bind via
       GOVERNOR_STORE_URL pointing at this host (env→config chain legs:
       env→store.url now, .local/mDNS later).
       W196 fail-closed: /rpc serves ONLY with GOVERNOR_STORE_TOKEN set —
       without it the server boots sealed (/health says sealed:true, /rpc 403).
       Provide the token at activation (installed plist EnvironmentVariables,
       launchctl setenv, or the unit's env file) and export the SAME value to
       every lane env that binds remotely. Every coord/work CLI on hosts that
       point store.url AT this server needs it too; hosts binding in-process
       (no store.url / GOVERNOR_STORE_URL=local) need nothing. -->
  <key>EnvironmentVariables</key><dict>
    <key>GOVERNOR_STORE_PORT</key><string>7794</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/suspenders-store-server.log</string>
  <key>StandardErrorPath</key><string>/tmp/suspenders-store-server.log</string>
</dict></plist>
