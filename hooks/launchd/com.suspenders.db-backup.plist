<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.db-backup</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__PREFIX__/bin/db-backup.ts</string>
  </array>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.claude-insights/logs/governor-backup.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.claude-insights/logs/governor-backup.log</string>
</dict></plist>
