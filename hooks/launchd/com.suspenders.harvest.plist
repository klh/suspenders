<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.suspenders.harvest</string>
  <key>ProgramArguments</key><array>
    <string>__BUN__</string>
    <string>__PREFIX__/bin/harvest.ts</string>
    <string>run</string>
    <string>--repo</string>
    <string>__REPO__</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/suspenders-harvest.log</string>
  <key>StandardErrorPath</key><string>/tmp/suspenders-harvest.log</string>
</dict></plist>
