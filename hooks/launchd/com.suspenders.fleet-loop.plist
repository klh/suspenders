<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.suspenders.fleet-loop</string>
	<key>ProgramArguments</key>
	<array>
		<string>__BUN__</string>
		<string>__PREFIX__/bin/fleet-loop.ts</string>
		<string>watch</string>
		<string>--repo</string>
		<string>__REPO__</string>
		<string>--ladder</string>
		<string>__LADDER__</string>
		<string>--every</string>
		<string>120</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/fleet-loop.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/fleet-loop.log</string>
</dict>
</plist>
