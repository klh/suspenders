# belt.env — suspenders installer stub: every response traverses the local
# belt (owner law, federation doc "Spoke install baseline"). Anthropic- and
# openai-protocol clients point at the belt entrypoint; the ladder in
# routing-policy.yaml (flash → local-swarm → openai → claude, never flashx)
# decides where each call lands. :4000 is the local swarm's anthropic router;
# :4100 the belt/litellm gateway.
# Fill ANTHROPIC_AUTH_TOKEN at activation; never commit the filled copy.
ANTHROPIC_BASE_URL=http://127.0.0.1:4100
ANTHROPIC_AUTH_TOKEN=
OPENAI_BASE_URL=http://127.0.0.1:4100/v1
